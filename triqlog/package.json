    "pg": "^8.11.3",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "crypto": "^1.0.1",
    "qrcode": "^1.5.3",
    "nodemailer": "^6.9.7",
    "twilio": "^4.19.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.10"
  }
