{
  "name": "triqlog-backend",
  "version": "1.0.0",
  "description": "TriqLog — Morocco Digital Freight Platform. Triple-lock escrow, GPS-triggered payments, DGI e-invoicing.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
